# ─────────────────────────────────────────────────────────────
# ESP-IDF v6.0 defaults for ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB Octal PSRAM)
# ─────────────────────────────────────────────────────────────

# Target chip
CONFIG_IDF_TARGET="esp32s3"

# Toolchain / build
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_WARNINGS_AS_ERRORS=n

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Octal PSRAM (N16R8 module)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_USE_MALLOC=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=y
CONFIG_FREERTOS_CHECK_THREADSAFE_API_FAILURE=y
CONFIG_FREERTOS_OPTIMIZED_THREAD_SELECTION=y

# I2S driver (new channel API only, legacy removed in v6.0)
CONFIG_I2S_DRIVER_USE_NEW_CHANNEL_API=y
CONFIG_I2S_DRIVER_LEGACY_API_COMPAT=n

# SPI / LCD
CONFIG_SPI_MASTER_IN_POLLED_GPIO=n
CONFIG_LCD_ENABLE=y

# Storage: enable wear-leveling / LittleFS support
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_LITTLEFS_MAX_PARTITIONS=2

# Power management
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_CPU_FREQ_MAX=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# Application
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096